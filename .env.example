# Client/Server shared environment variables

# Supabase Client (public keys only)
# Get from: Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# Supabase Database (PostgreSQL for Prisma)
# Get from: Supabase Dashboard > Settings > Database > Connection string > URI
# Use pooler host for production (recommended)
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://postgres:<DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require"

# Server-side only
GEMINI_API_KEY=your_gemini_api_key_here
STRIPE_SECRET_KEY=sk_test_mock_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
JWT_SECRET=your_jwt_secret_min_32_chars_here
SERVER_URL=http://localhost:8080

# Optional: used by link audits
# BASE_URL=

