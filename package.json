{
  "name": "havana",
  "private": true,
  "type": "module",
  "pkg": {
    "assets": [
      "dist/spa/*"
    ],
    "scripts": [
      "dist/server/**/*.js"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "vite build --config vite.config.server.ts",
    "start": "node dist/server/node-build.mjs",
    "test": "vitest",
    "format.fix": "prettier --write .",
    "typecheck": "tsc",
    "docs:refresh": "./scripts/project_overview.sh && ./scripts/routes_report.sh && ./scripts/readme_overview.sh && git add PROJECT_OVERVIEW.md ROUTES.md README.md && git add scripts/*.sh && git commit -m \"docs: refresh overview/routes/readme\"",
    "prepare": "husky install",
    "audit:routes": "node scripts/crawl.js",
    "audit:links": "linkinator --recurse --skip 'mailto:' $BASE_URL",
    "audit:lighthouse": "lhci autorun",
    "audit:a11y": "pa11y-ci",
    "audit:zap": "bash scripts/zap-baseline.sh",
    "audit:all": "npm run audit:routes && npm run audit:links && npm run audit:a11y && npm run audit:lighthouse"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,css,md,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.2",
    "axios": "^1.11.0",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^17.2.2",
    "express": "^4.18.2",
    "zod": "^3.23.8"
  },
